{
  "name": "onkkos-archive",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:stories": "vitest run --project storybook --passWithNoTests",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "knip": "knip",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "palette": "node scripts/palette.mjs"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@types/node": "22.18.12",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-boundaries": "7.2.0",
    "knip": "6.37.0",
    "playwright": "1.64.0",
    "prettier": "3.9.6",
    "storybook": "10.6.1",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20.9"
  }
}
